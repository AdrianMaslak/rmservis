# ══════════════════════════════════════════════
#  RM Autoservis — konfigurácia Apache hostingu
# ══════════════════════════════════════════════

# ── Bezpečnosť ───────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# Uložené objednávky nesmú byť verejné
<FilesMatch "\.(csv|log|md|json)$">
  Require all denied
</FilesMatch>
<Files "objednavky.csv">
  Require all denied
</Files>
Options -Indexes

# ── HTTPS a www → bez www ────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Ak chcete opačne (bez www → www), zakomentujte nasledujúce dva riadky
  # a odkomentujte tie pod nimi.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ── Kompresia ────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ── Cache ────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ── Chybová stránka ──────────────────────────
ErrorDocument 404 /index.html

AddDefaultCharset UTF-8
